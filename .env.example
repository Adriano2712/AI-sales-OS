# Copy to .env and fill in real values. Never commit .env.

# --- Database ------------------------------------------------------------
# App runtime connection: the restricted `ai_sales_os_app` role created by
# migration 0001 (RLS-enforced — see docs/DATABASE.md). This is what
# apps/api and workers/ actually connect as.
DATABASE_URL=postgresql+asyncpg://ai_sales_os_app:CHANGE_ME@db.YOUR_PROJECT.supabase.co:5432/postgres

# Admin connection used ONLY by Alembic to run migrations (Supabase's default
# `postgres` role). Never used by the running app.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Password migration 0001 sets for the ai_sales_os_app role (must match the
# password half of DATABASE_URL above). Generate with: openssl rand -base64 24
APP_ROLE_PASSWORD=CHANGE_ME

# --- Redis -----------------------------------------------------------------
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR-INSTANCE.upstash.io:6379

# --- Supabase Auth -----------------------------------------------------
# JWT verification fetches this project's public signing keys from
# SUPABASE_URL + /auth/v1/.well-known/jwks.json — no separate secret needed.
# (Supabase's current default signs tokens with an asymmetric key, e.g. ES256 —
# not the legacy HS256 shared "JWT Secret" from the dashboard.)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# --- AI Gateway --------------------------------------------------------
ANTHROPIC_API_KEY=CHANGE_ME

# --- Discovery: Apify (second provider, alongside OSM/Overpass) -----------
# Optional — the system runs OSM-only if unset (see
# jobs/handlers/discovery.py:build_providers). Get a token at
# https://console.apify.com -> Settings -> Integrations.
APIFY_API_TOKEN=CHANGE_ME
APIFY_DISCOVERY_ACTOR=compass/crawler-google-places

# --- Daily digest email (Gmail SMTP) ---------------------------------------
# Optional — workers/scheduler.py skips sending if any of these three are
# unset. GMAIL_SMTP_APP_PASSWORD is a Google "App Password" (16 chars,
# myaccount.google.com/apppasswords, requires 2-Step Verification), never
# your real Gmail login password.
GMAIL_SMTP_USER=CHANGE_ME
GMAIL_SMTP_APP_PASSWORD=CHANGE_ME
DAILY_DIGEST_RECIPIENT_EMAIL=CHANGE_ME

# --- Daily scheduled discovery (workers/scheduler.py) -----------------------
# Optional — unset means the scheduler process does nothing. See
# docs/DAILY_DIGEST.md.
DAILY_DISCOVERY_TENANT_ID=CHANGE_ME

# --- apps/web (Next.js) — public, safe to expose to the browser -----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME
NEXT_PUBLIC_API_URL=http://localhost:8000
